<mxfile host="app.diagrams.net"><diagram id="v17" name="v17"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2494" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="开始：用户上传文献（文献搜索由用户进行）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="40" width="260" height="56" as="geometry"/></mxCell><mxCell id="n2" value="S1.1 研究需求三问：功能单位／系统边界／ALCA 还是 CLCA（三问未定不开工）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="136" width="320" height="64" as="geometry"/></mxCell><mxCell id="n3" value="报错信号：不存在直通（不分配/不替代）情形——若判断课题无需处理联产品负担＝错误，核对文献实际做法（必有分配或替代）并如实汇报" style="note;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="380" height="96" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n5" value="S1.2 逐篇文献审查＋八维度比对打分采集（范式/数据类型/功能单位/边界/副产品/背景库/可追溯性/质量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="252" width="320" height="64" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n7" value="C1 有完整生命周期清单？（高度契合？）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="360" width="260" height="96" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="否＝如实汇报缺口；文献质量差→用户重新找文献，回到 S1.2；硬不匹配（功能单位不可换算）不进入打分，直接汇报" style="note;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="358" width="380" height="84" as="geometry"/></mxCell><mxCell id="n10" value="S1.3 多版本核验：内部标识＋关键单元格内容指纹→登记权威版；旧版数值不得进候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="492" width="320" height="64" as="geometry"/></mxCell><mxCell id="e11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;dashed=1;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="S1.4／C2 划分两池：完整清单文献池／参数选取文献池（池空→等待补充，不转纯建模）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="320" height="64" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="S2.1–2.3 维度比对打分→AI 推荐框架＋理由（只定结构不抓参数；骨架继承快速路径）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="708" width="320" height="64" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="框架确认（闸门 A）用户同意推荐框架？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="824" width="260" height="96" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="确认时登记：范式三分类 ①同属 CLCA ②同属 ALCA ③不同→分配/替代关注口径（详见 data-workflow.md 专节）；否决＝记录理由→池内换候选／扩大搜索回 S1.2；候选耗尽→报告等待" style="note;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="822" width="380" height="100" as="geometry"/></mxCell><mxCell id="e20" value="否决" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;dashed=1;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="d_c3 框架数据完善？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="956" width="260" height="96" as="geometry"/></mxCell><mxCell id="e22" value="确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n17" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="否＝登记缺口清单、请用户补充（优先用户进行）；不填猜测值、不以其他版本数据顶替" style="note;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="958" width="380" height="70" as="geometry"/></mxCell><mxCell id="e24" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;dashed=1;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="S3.1–3.2／C3 边界比对＋边界缩小菱形（用户裁定裁剪并登记）；资本品／背景过程显式询问；冲突→问题表，不受影响部分继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1088" width="320" height="88" as="geometry"/></mxCell><mxCell id="e26" value="完善" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n21" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="S3.3 最小黑箱＋模块划分（依文献结构；无依据→标待定，先找全流后归类）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1212" width="320" height="64" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="S3.4 逐过程识别全部流（输入/输出/内部转移/循环；过程总量不得伪装成操作量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1320" width="320" height="64" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="D1 该流参数涉及公式运算？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1436" width="260" height="96" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="是＝公式递归溯源：作者公式/代码版本＋输入参数；缺参数→列缺口不臆算；否＝固定值/范围记原值·单位·基准·来源" style="note;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1434" width="380" height="84" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;dashed=1;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="S3.6–3.7 逐流记录卡＋命名规整（稳定 ID；名称不作关联键）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1568" width="320" height="64" as="geometry"/></mxCell><mxCell id="e36" value="逐条判定后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n31" target="n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="QC 通过？（物料平衡／记录完整／覆盖度＋能源完整性主动核查）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1676" width="260" height="96" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="S4.1 汇报：清单审核＋工作质量评价＋数据支撑能力结论＋覆盖矩阵＋问题表（不能只交文件或笼统称已完成）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1808" width="320" height="82" as="geometry"/></mxCell><mxCell id="e40" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n37" target="n39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="否：返回对应步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;fontSize=11;dashed=1;" edge="1" parent="1" source="n37" target="n27"><mxGeometry relative="1" as="geometry"><Array as='points'><mxPoint x='90' y='1856'/><mxPoint x='90' y='1244'/></Array></mxGeometry></mxCell><mxCell id="n42" value="冻结确认（闸门 B）用户确认清单与待补项？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1924" width="260" height="96" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n39" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="否：按缺口返工重报" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;fontSize=11;dashed=1;" edge="1" parent="1" source="n42" target="n39"><mxGeometry relative="1" as="geometry"><Array as='points'><mxPoint x='900' y='1972'/><mxPoint x='900' y='1866'/></Array></mxGeometry></mxCell><mxCell id="n45" value="S4.2 输出《待补参数清单》＋ validate_workbook.py --freeze 冻结" style="rounded=1;whiteSpace=wrap;ht