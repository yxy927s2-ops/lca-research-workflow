        <mxCell id="d_c1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="&lt;div&gt;对比用户需求与文献内容，&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;是否存在高度可参考文献？&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="460" y="410" as="geometry" />
        </mxCell>
        <mxCell id="Q8ItKsFKwLFBp8KvoZqL-47" edge="1" parent="1" source="n_s32" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#000000,#000000);strokeWidth=1.8;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243747;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=9;" target="Q8ItKsFKwLFBp8KvoZqL-46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_s32" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;" value="S2.2 对所有纳入可高度参考的文献：&lt;div&gt;&lt;ol&gt;&lt;li&gt;提取工艺流程，确定每篇文献的技术路径&lt;/li&gt;&lt;li&gt;只定结构，不抓参数&lt;/li&gt;&lt;li&gt;需要考虑：ALCA模型（现状平均）还是CLCA模型（边际产出）？&lt;/li&gt;&lt;li&gt;例如：单位A的产出，需要哪些操作，不同文献的工艺区别在哪？&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="395" y="600" as="geometry" />
        </mxCell>
        <mxCell id="Q8ItKsFKwLFBp8KvoZqL-29" edge="1" parent="1" source="n_s33" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=light-dark(#000000,#000000);strokeWidth=1.8;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243747;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=9;" target="Q8ItKsFKwLFBp8KvoZqL-28">
