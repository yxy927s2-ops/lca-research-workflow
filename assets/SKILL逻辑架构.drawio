          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Q8ItKsFKwLFBp8KvoZqL-36" edge="1" parent="1" source="Y9HLL4rgv5Wrj4qhmyC9-1" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#000000,#000000);strokeWidth=1.8;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243747;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=9;" target="Q8ItKsFKwLFBp8KvoZqL-35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y9HLL4rgv5Wrj4qhmyC9-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="S1.1 用户的研究需求是什么？&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ol&gt;&lt;li&gt;功能单位是什么？——最终结果聚焦到什么（如&quot;1 kg 产品&quot;&quot;1 MJ 能量&quot;）&lt;/li&gt;&lt;li&gt;系统边界是什么？—— cradle-to-gate / cradle-to-grave？划到哪一步为止？&lt;/li&gt;&lt;li&gt;建模范式是哪个？——ALCA还是CLCA？&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;归因型（ALCA）：用平均数据，描述&quot;现状责任分摊&quot;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;后果型（CLCA）：用边际供应商数据，描述&quot;多生产一单位带来的变化&quot;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="442" x="379" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="Q8ItKsFKwLFBp8KvoZqL-14" edge="1" parent="1" source="n_s11" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=light-dark(#000000,#000000);strokeWidth=1.8;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243747;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=9;" target="d_c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Q8ItKsFKwLFBp8KvoZqL-39" edge="1" parent="1" source="n_s11" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=light-dark(#000000,#000000);strokeWidth=1.8;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243747;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=9;" target="Q8ItKsFKwLFBp8KvoZqL-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_s11" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;" value="S1.2 文献审查，对已有模型评估，比对其与用户研究方向：&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ol&gt;&lt;li&gt;对用户所发的文献数据进行归类，按照所属文献进行整理，一份数据来源一个单独文件夹&lt;/li&gt;&lt;li&gt;文献的建模范式是归因型还是后果型？&lt;/li&gt;&lt;li&gt;数据类型是平均数据还是边际供应商数据？&lt;/li&gt;&lt;li&gt;功能单位是什么？与你的功能单位是否相似、可否换算？&lt;/li&gt;&lt;li&gt;系统边界是什么？与你的边界是否重合？&lt;/li&gt;&lt;li&gt;副产品怎么处理？——分配还是替代？如果是分配：经济分配、按质量、按蛋白质因子，还是别的系数？&lt;/li&gt;&lt;li&gt;背景数据库用的什么？（如 ecoinvent 哪个版本、哪个区域）&lt;/li&gt;&lt;li&gt;数据来自哪里？——工厂实测还是文献引用值？&lt;/li&gt;&lt;li&gt;文献质量审查：期刊质量，作者，发表时间等&lt;/li&gt;&lt;li&gt;注意点：这一步需要考虑在用户选定的文献中，哪几篇文献或数据来源具有最高的参考价值，可作为产品生命周期建模的框架？在清单中选择高度契合的文献进行分析，由用户选择后选定某一篇文献或数据来源作为框架。&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="680" x="260" y="140" as="geometry" />
        </mxCell>
