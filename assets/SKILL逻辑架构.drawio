  <diagram id="lca-workflow" name="LCA文献数据整理工作流">
    <mxGraphModel dx="1201" dy="3762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2900" math="0" shadow="0">
