<mxfile host="app.diagrams.net" type="device"><diagram id="v15auto" name="Page-1"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040.0" pageHeight="1715.0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="M2" value="" style="rounded=1;arcSize=2;container=1;pointerEvents=0;fillColor=#F6FAFC;strokeColor=#A8C7DA;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="570.0" y="260.0" width="835.0" height="870.0" as="geometry"/></mxCell><mxCell id="PR-DEFAT-header" value="&lt;b&gt;Ⅱ 大豆脱脂&lt;/b&gt;" style="fillColor=#DCEEF7;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=27;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M2"><mxGeometry x="0.9" y="1.0" width="833.1" height="62.0" as="geometry"/></mxCell><mxCell id="PR-DEFAT-en" value="Conditioning, flaking and defatting" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M2"><mxGeometry x="9.5" y="65.0" width="816.0" height="36.0" as="geometry"/></mxCell><mxCell id="title" value="大豆分离蛋白（SPI）基于流程的前景清单" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=40;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1112.0" y="90.0" width="816.0" height="60.0" as="geometry"/></mxCell><mxCell id="subtitle" value="功能单位：1 kg SPI 产品 Siegrist et al., 2026 加工前景 · 作者参数化模型代表情景" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=23;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="166.0" width="2960.0" height="40.0" as="geometry"/></mxCell><mxCell id="M1" value="" style="rounded=1;arcSize=2;container=1;pointerEvents=0;fillColor=#F6FAFC;strokeColor=#A8C7DA;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="260.0" width="506.0" height="870.0" as="geometry"/></mxCell><mxCell id="PR-DEHULL-header" value="&lt;b&gt;Ⅰ 清理、破碎与脱壳&lt;/b&gt;" style="fillColor=#DCEEF7;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=27;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M1"><mxGeometry x="1.0" y="1.0" width="505.0" height="62.0" as="geometry"/></mxCell><mxCell id="PR-DEHULL-en" value="Cracking and dehulling" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M1"><mxGeometry x="10.0" y="65.0" width="445.0" height="36.0" as="geometry"/></mxCell><mxCell id="M3" value="" style="rounded=1;arcSize=2;container=1;pointerEvents=0;fillColor=#F6FAFC;strokeColor=light-dark(#4490ca, #9477ba);strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1429.0" y="260.0" width="1575.0" height="870.0" as="geometry"/></mxCell><mxCell id="PR-ISOLATE-header" value="&lt;b&gt;Ⅲ SPI 蛋白提取&lt;/b&gt;" style="fillColor=#DCEEF7;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=27;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="1.0" y="1.0" width="1573.0" height="62.0" as="geometry"/></mxCell><mxCell id="PR-ISOLATE-en" value="Soy protein isolation (isoelectric precipitation)" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="10.0" y="65.0" width="1555.0" height="36.0" as="geometry"/></mxCell><mxCell id="figure-note" value="模块Ⅱ水、电、热仅有模块总量；模块Ⅲ能耗按作者公式拆至操作，泵送电耗 0.0082 kWh（×1.15）注于模块Ⅲ电力框内。模块Ⅲ外部取水 16.98 kg（作者 tap_water 公式值）、废水排放 11.490 kg（0.01149 m³）；工艺投水 25.852 kg 含厂内循环，不进 LCI（口径详见冻结清单 Q04）。NaOH/HCl 按 10% 溶液体积计（* 为审计中值，口径详见冻结清单问题表）。脱脂废水原文以 m³ 列示（0.000625 m³＝0.6251 kg），图中统一 kg。图中水量除注明外均为 kg（质量口径）。蒸发水原文以 m³ 列示（0.004938 m³＝4.9375 kg），图中统一 kg。" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1650.0" width="2960.0" height="31.0" as="geometry"/></mxCell><mxCell id="source-note" value="来源：Siegrist et al. (2026), Sustainable Production and Consumption 62, 127–138；官方补充数据 mmc2（SPI、Defatting、Formulas_SPI 工作表），内容与作者 GitHub runtime 数据一致。干物质条件：白豆片 88%（SPI!H29）、SPI 95%（dm_output）、豆渣含水约 10%（作者公式假设）；图中水量统一为 kg 质量口径，m³ 仅为换算参考。" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1682.0" width="2960.0" height="27.0" as="geometry"/></mxCell><mxCell id="legend-band" value="" style="fillColor=#FFFFFF;strokeColor=#BCD0DD;strokeWidth=1;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="70.0" y="140.0" width="756.3" height="92.0" as="geometry"/></mxCell><mxCell id="legend-title" value="图例" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=25;fontStyle=1;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="86.2" y="170.0" width="70.4" height="36.0" as="geometry"/></mxCell><mxCell id="legend-box-0" value="" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="167.2" y="167.0" width="44.5" height="35.0" as="geometry"/></mxCell><mxCell id="legend-label-0" value="单元操作" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="220.6" y="160.0" width="210.5" height="48.0" as="geometry"/></mxCell><mxCell id="legend-box-2" value="" style="rounded=1;arcSize=8;fillColor=#E7F4FD;strokeColor=#4F94C6;strokeWidth=1.6;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="333.2" y="167.0" width="44.5" height="35.0" as="geometry"/></mxCell><mxCell id="legend-label-2" value="水与液相" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="397.9" y="160.0" width="210.5" height="48.0" as="geometry"/></mxCell><mxCell id="legend-box-3" value="" style="rounded=1;arcSize=8;fillColor=#F1EAFB;strokeColor=#9270BE;strokeWidth=1.6;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="503.2" y="166.5" width="44.5" height="35.0" as="geometry"/></mxCell><mxCell id="legend-label-3" value="化学品" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="568.0" y="160.0" width="210.5" height="48.0" as="geometry"/></mxCell><mxCell id="legend-box-4" value="" style="rounded=1;arcSize=0;fillColor=#FBE8E2;strokeColor=#C9836E;strokeWidth=1.4;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="660.0" y="166.5" width="44.5" height="35.0" as="geometry"/></mxCell><mxCell id="legend-label-4" value="能源投入" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=8;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1"><mxGeometry x="720.0" y="160.0" width="102.2" height="48.0" as="geometry"/></mxCell><mxCell id="op_M1-OP1" value="&lt;b&gt;清理、破碎与脱壳&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;除杂、去除豆壳&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M1"><mxGeometry x="170.0" y="285.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="op_M2-OP1" value="&lt;b&gt;调质&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;调节豆粒状态&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M2"><mxGeometry x="38.0" y="285.0" width="151.8" height="90.0" as="geometry"/></mxCell><mxCell id="op_M2-OP2" value="&lt;b&gt;压片&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;压薄以利萃取&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M2"><mxGeometry x="227.7" y="285.0" width="151.8" height="90.0" as="geometry"/></mxCell><mxCell id="op_M2-OP3" value="&lt;b&gt;正己烷萃取&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;用正己烷溶出豆油&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M2"><mxGeometry x="417.5" y="285.0" width="151.8" height="90.0" as="geometry"/></mxCell><mxCell id="op_M3-OP1" value="&lt;b&gt;浸泡 / 碱溶&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;碱溶大豆蛋白&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#A75E49'&gt;热 3.0438 MJ&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="60.0" y="282.0" width="180.0" height="96.0" as="geometry"/></mxCell><mxCell id="op_M3-OP2" value="&lt;b&gt;离心 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;分出蛋白提取液&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#A75E49'&gt;电 0.0201 kWh&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="330.0" y="282.0" width="180.0" height="96.0" as="geometry"/></mxCell><mxCell id="op_M3-OP3" value="&lt;b&gt;离心 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;酸沉蛋白并分出乳清&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#A75E49'&gt;电 0.0189 kWh&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="330.0" y="545.0" width="185.0" height="96.0" as="geometry"/></mxCell><mxCell id="op_M3-OP4" value="&lt;b&gt;离心 4&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;洗涤蛋白沉淀&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#A75E49'&gt;电 0.0138 kWh&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeColor=#4D885C;strokeWidth=1.8;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#243747;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="M3"><mxGeometry x="830.0" y="545.0" width="170.0" height="96.0" as="geometry"/></mxCell><mxCell id="op_M3-OP5" value="&lt;b&gt;离心 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#4D6755'&gt;洗涤湿豆片并回水&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px;color:#A75E49'&gt;电 0.001257 kWh&lt;/span&gt;" style="rounded=1;arcSize=9;fillColor=#E5F2E6;strokeC